rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'x12aa10000@gmail.com'; }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function isTeam() { return isAdmin() || isMember(); }

    match /users/{uid} {
      allow read: if isTeam();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMember() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'email']));
    }
    match /payouts/{id} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }
    match /clients/{id} { allow read, write: if isTeam(); }
    match /projects/{id} { allow read, write: if isTeam(); }
    match /appointments/{id} { allow read, write: if isTeam(); }
  }
}
